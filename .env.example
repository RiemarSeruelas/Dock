APP_PORT=5059
APP_ORIGIN=http://localhost:5059
CORS_ORIGINS=http://localhost:3000,http://localhost:5059
ALLOW_PRIVATE_NETWORK_ORIGINS=true
API_INTERNAL_URL=http://localhost:3001
JWT_SECRET=change-this-backward-compatible-secret
ACCESS_TOKEN_SECRET=change-this-to-a-long-random-access-secret
REFRESH_TOKEN_SECRET=change-this-to-a-different-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=dockflow_refresh
COOKIE_SECURE=false

# Used only when the JSON store has no users. Change these before the first run.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=1200
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=60

# Free address-to-address ETA: OSRM road distance plus a 30-40 km/h
# time-of-day speed assumption. This does not use paid/live traffic data.
GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving
FREE_TRAFFIC_ESTIMATE_ENABLED=true
TRAFFIC_ESTIMATE_BUFFER_MINUTES=3
# Replace with an identifying app/contact value or point the URLs to your own provider.
ETA_USER_AGENT=DockFlow/0.1 (admin-contact@example.com)
ETA_API_TIMEOUT_MS=10000

# Trial mode: delivery data is stored in data/trial-data.json.
# Refresh sessions stay in memory and reset when the API restarts.
DB_ENABLED=false

# Administrator email sender. Keep the real values only in .env; .env is ignored
# by Git and excluded from the downloadable build. For Gmail, use a Google App
# Password—not the administrator's normal Gmail password.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_with_admin_gmail@gmail.com
SMTP_APP_PASSWORD=replace_with_google_app_password
# Optional. Leave blank to send as "DockFlow <SMTP_USER>".
MAIL_FROM=

TZ=Asia/Manila

# SAP worksheet database, separate from JSON business storage / DB_ENABLED.
SAP_STORAGE=postgres
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_DB=docker
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_SCHEMA=Analysis
POSTGRES_SESSION_LOGS_TABLE=SAPAnalysis
POSTGRES_SSL=false
# Optional extra network restriction. Keep false for role-controlled access from
# approved company workstations regardless of which connected Wi-Fi is selected.
SAP_NETWORK_RESTRICTION_ENABLED=false
# Used only when SAP_NETWORK_RESTRICTION_ENABLED=true.
# Comma-separated client/VPN CIDRs. Empty then means no SAP data for any client.
SAP_ALLOWED_CIDRS=
# Used only when SAP_NETWORK_RESTRICTION_ENABLED=true. Add only trusted proxies
# that sanitize X-Forwarded-For; never add a public client CIDR.
SAP_TRUSTED_PROXY_CIDRS=

# Optional reverse proxy in front of the web server (empty for direct access).
WEB_TRUSTED_PROXY_CIDRS=




SAP_NETWORK_RESTRICTION_ENABLED=false
#Add this